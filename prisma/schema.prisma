generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

//--------------------------------------------
/// Tabela de habilidades educacionais BNCC
//--------------------------------------------
model Bncc {
  id          String   @id
  type        String
  code        String?
  name        String
  description String
  isBNCC      Boolean
  subGroup    String
  grade       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([type])
  @@index([grade])
  @@index([subGroup])
}

//--------------------------------------------
/// Tabela de Usuários do Sistema
//--------------------------------------------
model User {
  id               String   @id @default(cuid())
  name             String
  role             String
  avatar           String?
  email            String   @unique
  password         String
  cpf              String?
  phone            String?
  birthDate        String?
  address          String?
  hiringDate       String?
  education        String?
  specialization   String[]
  bio              String?
  status           String   @default("active")
  assignedClassIds String[]
  linkedStudentIds String[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  accounts         Account[]
  sessions         Session[]

  @@index([email])
  @@index([role])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

//--------------------------------------------
/// Tabela de Turmas Escolares
//--------------------------------------------
model SchoolClass {
  id          String   @id @default(cuid())
  name        String
  description String?
  teacherId   String?
  assistantId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  students    Student[]

  @@index([teacherId])
  @@index([assistantId])
}

model Student {
  id                   String        @id @default(cuid())
  name                 String
  dateOfBirth          String        // YYYY-MM-DD
  document             String?
  schoolStage          String?
  period               String?       // "integral" | "matutino"
  photo                String?
  classId              String
  schoolClass          SchoolClass   @relation(fields: [classId], references: [id])
  status               String        @default("presente") // "presente" | "ausente"
  
  age                  Int?
  parentName           String?
  
  guardians            Json?         // StudentGuardian[]
  financialResponsible Json?         // StudentFinancialResponsible
  health               Json?         // StudentHealth
  emergencyContacts    Json?         // StudentEmergencyContact[]
  documents            Json?         // StudentDocuments
  
  hospitalPreference   String?
  hospitalAddress      String?

  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@index([classId])
  @@index([status])
}

//--------------------------------------------
/// Mural de Eventos e Comunicados
//--------------------------------------------
model MuralEvent {
  id          String   @id @default(cuid())
  title       String
  description String   @db.Text
  date        DateTime
  author      String
  type        String   // "event" | "notice" | "activity"
  location    String?
  image       String?  @db.Text
  classId     String?
  likes       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  comments    MuralComment[]

  @@index([classId])
}

model MuralComment {
  id           String   @id @default(cuid())
  author       String
  text         String   @db.Text
  date         DateTime @default(now())
  muralEventId String
  muralEvent   MuralEvent @relation(fields: [muralEventId], references: [id], onDelete: Cascade)

  @@index([muralEventId])
}
