generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// Tabela de habilidades educacionais BNCC
model Bncc {
  id          String   @id
  type        String
  code        String?
  name        String
  description String
  isBNCC      Boolean
  subGroup    String
  grade       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([type])
  @@index([grade])
  @@index([subGroup])
}

/// Tabela de Usuários do Sistema
model User {
  id               String    @id @default(cuid())
  name             String
  role             String
  avatar           String?
  email            String    @unique
  cpf              String?
  phone            String?
  birthDate        String?
  address          String?
  hiringDate       String?
  education        String?
  specialization   String[]
  bio              String?
  status           String    @default("active")
  assignedClassIds String[]
  linkedStudentIds String[]
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  password         String
  accounts         Account[]
  sessions         Session[]

  @@index([email])
  @@index([role])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/// Tabela de Turmas Escolares
model SchoolClass {
  id          String    @id @default(cuid())
  name        String
  description String?
  teacherId   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  assistantId String?
  students    Student[]

  @@index([teacherId])
  @@index([assistantId])
}

model Student {
  id                   String      @id @default(cuid())
  name                 String
  dateOfBirth          String
  document             String?
  schoolStage          String?
  period               String?
  photo                String?
  classId              String
  status               String      @default("presente")
  age                  Int?
  parentName           String?
  guardians            Json?
  financialResponsible Json?
  health               Json?
  emergencyContacts    Json?
  documents            Json?
  hospitalPreference   String?
  hospitalAddress      String?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  schoolClass          SchoolClass @relation(fields: [classId], references: [id])
  portfolioEntries     PortfolioEntry[]

  @@index([classId])
  @@index([status])
}

/// Portfólio dos Alunos
model PortfolioEntry {
  id          String   @id @default(cuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id])
  date        String
  title       String
  description String   @db.Text
  imageUrl    String?
  images      String[]
  tags        String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([studentId])
}

/// Mural de Eventos e Comunicados
model MuralEvent {
  id          String         @id @default(cuid())
  title       String
  description String
  date        DateTime
  author      String
  type        String
  location    String?
  image       String?
  classId     String?
  likes       Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  comments    MuralComment[]

  @@index([classId])
}

model MuralComment {
  id           String     @id @default(cuid())
  author       String
  text         String
  date         DateTime   @default(now())
  muralEventId String
  muralEvent   MuralEvent @relation(fields: [muralEventId], references: [id], onDelete: Cascade)

  @@index([muralEventId])
}

/// Pegadas dos Ibiritos (Postagens e Feed)
model PegadaPost {
  id           String              @id @default(cuid())
  authorId     String
  authorName   String
  type         String
  title        String
  content      String
  mediaUrl     String?
  mediaUrls    String[]
  tags         String[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  interactions PegadaInteraction[]
}

model PegadaInteraction {
  id           String     @id @default(cuid())
  userId       String
  userName     String
  type         String
  content      String?
  audioUrl     String?
  createdAt    DateTime   @default(now())
  pegadaPostId String
  pegadaPost   PegadaPost @relation(fields: [pegadaPostId], references: [id], onDelete: Cascade)

  @@index([pegadaPostId])
}

/// Projetos Educacionais
model Project {
  id              String   @id @default(cuid())
  title           String
  description     String   @db.Text
  status          String   @default("draft")
  startDate       DateTime
  endDate         DateTime?
  period          String?
  type            String?
  summary         String?  @db.Text
  objectives      String?  @db.Text
  finalProduct    String?
  guidingQuestion String?  @db.Text
  imageUrl        String?
  tags            String[]
  bnccSkillIds    String[]
  contentIds      String[]
  students        String[]
  classes         String[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

/// Rotina Escolar e Agenda
model ScheduleItem {
  id          String   @id @default(cuid())
  time        String
  endTime     String?
  title       String
  type        String
  description String?  @db.Text
  date        String?
  classId     String?
  projectId   String?
  routineId   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([classId])
  @@index([projectId])
  @@index([routineId])
}

/// Notificações do Sistema
model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String
  isRead    Boolean  @default(false)
  studentId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

/// Sistema de Tarefas/Lembretes Globais
model Task {
  id        String   @id @default(cuid())
  title     String
  completed Boolean  @default(false)
  dueDate   String?
  priority  String   @default("medium")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Finanças e Faturas
model Invoice {
  id            String   @id @default(cuid())
  studentId     String
  description   String
  amount        Float
  dueDate       String
  status        String   @default("pendente")
  paymentDate   String?
  paymentMethod String?
  bankId        String?
  barcode       String?
  pixCode       String?
  pdfUrl        String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([studentId])
}
