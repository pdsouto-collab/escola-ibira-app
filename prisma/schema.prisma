generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// Tabela de habilidades educacionais BNCC
model Bncc {
  id          String   @id
  type        String
  code        String?
  name        String
  description String
  isBNCC      Boolean
  subGroup    String
  grade       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([type])
  @@index([grade])
  @@index([subGroup])
}

/// Tabela de Usuários do Sistema
model User {
  id               String        @id @default(cuid())
  name             String
  role             String
  avatar           String?
  email            String        @unique
  cpf              String?
  phone            String?
  birthDate        String?
  address          String?
  hiringDate       String?
  education        String?
  specialization   String[]
  bio              String?
  status           String        @default("active")
  assignedClassIds String[]
  linkedStudentIds String[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  password         String
  rg               String?
  roles            String[]      @default([])
  accounts         Account[]
  receivedMessages ChatMessage[] @relation("ReceivedMessages")
  sentMessages     ChatMessage[] @relation("SentMessages")
  sessions         Session[]
  chatGroups       ChatGroup[]   @relation("GroupParticipants")

  @@index([email])
  @@index([role])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/// Tabela de Turmas Escolares
model SchoolClass {
  id          String    @id @default(cuid())
  name        String
  description String?
  teacherId   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  assistantId String?
  students    Student[]

  @@index([teacherId])
  @@index([assistantId])
}

model Student {
  id                   String           @id @default(cuid())
  name                 String
  dateOfBirth          String
  document             String?
  schoolStage          String?
  period               String?
  photo                String?
  classId              String
  status               String           @default("presente")
  age                  Int?
  parentName           String?
  guardians            Json?
  financialResponsible Json?
  health               Json?
  emergencyContacts    Json?
  documents            Json?
  hospitalPreference   String?
  hospitalAddress      String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  dailyLogs            DailyLog[]
  portfolioEntries     PortfolioEntry[]
  schoolClass          SchoolClass      @relation(fields: [classId], references: [id])

  @@index([classId])
  @@index([status])
}

/// Portfólio dos Alunos
model PortfolioEntry {
  id          String   @id @default(cuid())
  studentId   String
  date        String
  title       String
  description String
  imageUrl    String?
  images      String[]
  tags        String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  student     Student  @relation(fields: [studentId], references: [id])

  @@index([studentId])
}

/// Mural de Eventos e Comunicados
model MuralEvent {
  id          String         @id @default(cuid())
  title       String
  description String
  date        DateTime
  author      String
  type        String
  location    String?
  image       String?
  classId     String?
  likes       Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  isArchived  Boolean        @default(false)
  comments    MuralComment[]

  @@index([classId])
  @@index([isArchived])
}

model MuralComment {
  id           String     @id @default(cuid())
  author       String
  text         String
  date         DateTime   @default(now())
  muralEventId String
  muralEvent   MuralEvent @relation(fields: [muralEventId], references: [id], onDelete: Cascade)

  @@index([muralEventId])
}

/// Pegadas dos Ibiritos (Postagens e Feed)
model PegadaPost {
  id           String              @id @default(cuid())
  authorId     String
  authorName   String
  type         String
  title        String
  content      String
  mediaUrl     String?
  mediaUrls    String[]
  tags         String[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  classId      String?             @default("all")
  classIds     String[]            @default([])
  studentIds   String[]            @default([])
  interactions PegadaInteraction[]
}

model PegadaInteraction {
  id           String     @id @default(cuid())
  userId       String
  userName     String
  type         String
  content      String?
  audioUrl     String?
  createdAt    DateTime   @default(now())
  pegadaPostId String
  pegadaPost   PegadaPost @relation(fields: [pegadaPostId], references: [id], onDelete: Cascade)

  @@index([pegadaPostId])
}

/// Projetos Educacionais
model Project {
  id              String    @id @default(cuid())
  title           String
  description     String
  status          String    @default("draft")
  startDate       DateTime
  endDate         DateTime?
  period          String?
  type            String?
  summary         String?
  objectives      String?
  finalProduct    String?
  guidingQuestion String?
  imageUrl        String?
  tags            String[]
  bnccSkillIds    String[]
  contentIds      String[]
  students        String[]
  classes         String[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  photos          String[]  @default([])
}

/// Rotina Escolar e Agenda
model ScheduleItem {
  id          String   @id @default(cuid())
  time        String
  endTime     String?
  title       String
  type        String
  description String?
  date        String?
  classId     String?
  projectId   String?
  routineId   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([classId])
  @@index([projectId])
  @@index([routineId])
}

/// Notificações do Sistema
model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String
  isRead    Boolean  @default(false)
  studentId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

/// Sistema de Tarefas/Lembretes Globais
model Task {
  id        String   @id @default(cuid())
  title     String
  completed Boolean  @default(false)
  dueDate   String?
  priority  String   @default("medium")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Finanças e Faturas
model Invoice {
  id            String   @id @default(cuid())
  studentId     String
  description   String
  amount        Float
  dueDate       String
  status        String   @default("pendente")
  paymentDate   String?
  paymentMethod String?
  bankId        String?
  barcode       String?
  pixCode       String?
  pdfUrl        String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([studentId])
}

/// Diário de Bordo (Daily Log)
model DailyLog {
  id           String   @id @default(cuid())
  studentId    String
  date         String
  mood         String
  meals        Json
  nap          Json
  activities   String[]
  notes        String
  missingItems String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([date])
}

/// Tipos de Produto Final
model FinalProductType {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Tipos de Projeto
model ProjectType {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Avaliações (Assessments)
model Assessment {
  id              String                 @id @default(cuid())
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  projectId       String?
  sessionId       String?
  routineId       String?
  knowledgeNodeId String?
  period          String?
  scope           String
  classId         String?
  studentId       String?
  rating          Int?
  observations    String
  isPublished     Boolean                @default(true)
  attachments     AssessmentAttachment[]

  @@index([studentId])
  @@index([projectId])
  @@index([knowledgeNodeId])
}

model AssessmentAttachment {
  id           String     @id @default(cuid())
  assessmentId String
  type         String
  url          String
  name         String?
  capturedAt   String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@index([assessmentId])
}

/// Tronco da Turma (Class Board)
model ClassBoardPost {
  id              String                      @id @default(cuid())
  classId         String
  authorId        String
  authorName      String
  authorRole      String?
  categoryType    String
  linkedProjectId String?
  title           String
  content         String
  extraMaterials  String?
  photos          String[]
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt
  interactions    ClassBoardPostInteraction[]

  @@index([classId])
}

model ClassBoardPostInteraction {
  id        String         @id @default(cuid())
  postId    String
  userId    String
  userName  String
  userRole  String?
  type      String
  content   String?
  createdAt DateTime       @default(now())
  post      ClassBoardPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
}

/// Cardápios e Refeições
model Menu {
  id        String     @id @default(cuid())
  date      String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  items     MenuItem[]
}

model MenuItem {
  id              String   @id @default(cuid())
  time            String?
  title           String
  description     String
  menuId          String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  timeFundamental String?
  timeInfantil    String?
  menu            Menu     @relation(fields: [menuId], references: [id], onDelete: Cascade)

  @@index([menuId])
}

/// Grupos de Chat
model ChatGroup {
  id           String        @id @default(cuid())
  name         String
  avatar       String?
  createdAt    DateTime      @default(now())
  messages     ChatMessage[]
  participants User[]        @relation("GroupParticipants")

  @@index([createdAt])
}

/// Chat Individual/Grupo
model ChatMessage {
  id         String     @id @default(cuid())
  senderId   String
  receiverId String?
  groupId    String?
  content    String
  read       Boolean    @default(false)
  createdAt  DateTime   @default(now())
  readBy     String[]   @default([])
  group      ChatGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)
  receiver   User?      @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  sender     User       @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([senderId])
  @@index([receiverId])
  @@index([groupId])
  @@index([createdAt])
}

/// Sistema de Árvores do Conhecimento (Base Habilidades/Conteúdos)
model KnowledgeNode {
  id            String          @id @default(cuid())
  level         String
  type          String
  name          String
  description   String?
  libraryItemId String?
  classId       String?
  period        String?
  parentId      String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  parent        KnowledgeNode?  @relation("NodeToNode", fields: [parentId], references: [id], onDelete: Cascade)
  children      KnowledgeNode[] @relation("NodeToNode")

  @@index([type])
  @@index([classId])
  @@index([parentId])
}

/// Sistema de Mosaico (Estrutura de exibição visual)
model MosaicNode {
  id        String       @id @default(cuid())
  label     String
  type      String
  color     String?
  weight    Int?
  parentId  String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  parent    MosaicNode?  @relation("MosaicToMosaic", fields: [parentId], references: [id], onDelete: Cascade)
  children  MosaicNode[] @relation("MosaicToMosaic")

  @@index([parentId])
}

/// Registro do Progresso das Habilidades BNCC (Global ou por Aluno futuramente)
model BnccProgress {
  id            String   @id @default(cuid())
  skillCode     String   @unique
  status        String   @default("not-started")
  evidenceCount Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
